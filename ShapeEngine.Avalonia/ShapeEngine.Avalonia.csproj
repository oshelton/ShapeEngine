<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latestmajor</LangVersion>
    <Title>Shape Engine Avalonia</Title>
    <Description>Avalonia UI integration for Shape Engine. Hosts a real Avalonia TopLevel inside the raylib window and renders it with Skia directly onto the engine's OpenGL surface.</Description>
    <Authors>Dave Green</Authors>
    <Company>Dave Green Games</Company>
    <Product>Shape Engine</Product>
    <PackageId>DaveGreen.ShapeEngine.Avalonia</PackageId>
    <PackageTags>GameEngine Framework 2D raylib gamedev ui avalonia skia</PackageTags>
    <RepositoryUrl>https://github.com/DaveGreen-Games/ShapeEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!--
    Hosting Avalonia inside another renderer requires implementing Avalonia's platform backend
    interfaces (IPlatformRenderSurface and friends), which are sealed off from user code in
    Avalonia 12 unless these opt-ins are set. This is the same mechanism Estragonia uses for its
    Godot backend. The trade-off is that the Avalonia version must be pinned exactly - see the
    PackageReference versions below, which are deliberately not floating.
  -->
  <PropertyGroup>
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>true</Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShapeEngine\ShapeEngine.csproj" />
  </ItemGroup>

</Project>
